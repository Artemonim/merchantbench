# Copy to .env and fill in. .env is gitignored.
# Values are read by ReAct / Hermes bootstrap and by eval/run_eval.py.

# --- OpenRouter (OpenAI-compatible) ---
OPENAI_API_KEY=YOUR_OPENROUTER_API_KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter also accepts this alias; Hermes prefers it when present.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Target model for MerchantBench LLM runs (Hermes / ReAct).
# Baidu FP8 + Max reasoning are applied via Hermes profile seed
# (scripts/hermes_openrouter_profile.snippet.yaml), not via the model slug.
MODEL_NAME=deepseek/deepseek-v4-flash-0731

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://github.com/Artemonim/merchantbench
# OPENROUTER_X_TITLE=MerchantBench

# --- Dedicated Hermes checkout for MerchantBench (NOT the personal agent home) ---
# ! Do NOT point this at G:\Hermes — that directory is a personal HERMES_HOME
#   (auth/sessions/gateway), not the source tree used as the adapter runtime.
# Expects <root>/merchantbench_adapter/__main__.py inside the checkout.
MERCHANTBENCH_HERMES_AGENT_ROOT=G:\GitHubImports\Hermes
# Windows: runner defaults look for .venv/bin/python; pin Scripts explicitly.
MERCHANTBENCH_HERMES_PYTHON=G:\GitHubImports\Hermes\.venv\Scripts\python.exe

# Opt-in: seed each new run-local hermes_home/config.yaml with OpenRouter
# Baidu FP8 + reasoning xhigh (max). Use "1" or an absolute path to a YAML file.
MERCHANTBENCH_HERMES_PROFILE_SEED=1
