# Copy to .env and fill in. .env is excluded from redistributed archives.
# These values are read by the ReAct baseline and forwarded into an agent
# container by eval/run_eval.py.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=

# Optional host directory containing private_real SQLite files and daily_reports/.
# env/run.py loads it locally; eval/run_eval.py mounts it read-only into the env
# container. Former REALSHOP_PRIVATE_DATA_ROOT is accepted for old deployments.
MERCHANTBENCH_PRIVATE_DATA_ROOT=
